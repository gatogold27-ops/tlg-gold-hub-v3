-- STATS
local function GS(plr)
    local s={Level=0,Health=0,MaxHealth=0,Melee=0,Weapon=0,Power=0,Kills=0,Deaths=0}
    pcall(function()
        local ch=plr.Character
        if ch then
            local hu=ch:FindFirstChildOfClass("Humanoid")
            if hu then s.Health=math.floor(hu.Health) s.MaxHealth=math.floor(hu.MaxHealth) end
        end
    end)
    local function sc(f)
        if not f then return end
        for _,v in ipairs(f:GetChildren()) do
            if v:IsA("IntValue") or v:IsA("NumberValue") then
                local n=v.Name:lower()
                local val=tonumber(v.Value) or 0
                if n=="level" or n=="nivel" or n=="lvl" then s.Level=val
                elseif n=="kills" or n=="kill" then s.Kills=val
                elseif n=="deaths" or n=="death" then s.Deaths=val
                elseif n=="melee" or n=="meleelevel" then s.Melee=val
                elseif n=="sword" or n=="swordlevel" or n=="weapon" or n=="arma" then s.Weapon=val
                elseif n=="power" or n=="poder" or n=="memepowerlevel" then s.Power=val end
            elseif v:IsA("Folder") or v:IsA("Configuration") then sc(v) end
        end
    end
    for _,nn in ipairs({"leaderstats","PlayerData","Stats","Data"}) do
        pcall(function() sc(plr:FindFirstChild(nn)) end)
    end
    return s
end

-- CONFIG SYSTEM
local CFG={File="TLG_Config.json",Reg={t={},s={}},HasIO=false}
pcall(function() CFG.HasIO=(writefile and readfile and isfile and delfile)~=nil end)
local function RegT(k,g,s,cb) CFG.Reg.t[k]={g=g,s=s,cb=cb} end
local function RegSl(k,g,s,cb) CFG.Reg.s[k]={g=g,s=s,cb=cb} end
local function Cap()
    local d={t={},s={},m={theme=CurT,custom=CA and {R=CA.R,G=CA.G,B=CA.B} or nil}}
    for k,v in pairs(CFG.Reg.t) do pcall(function() d.t[k]=v.g() end) end
    for k,v in pairs(CFG.Reg.s) do pcall(function() d.s[k]=v.g() end) end
    return d
end
local function CApply(d)
    if not d then return end
    if d.m and d.m.theme and Themes[d.m.theme] then
        CurT=d.m.theme
        if d.m.custom then CA=Color3.new(d.m.custom.R,d.m.custom.G,d.m.custom.B) else CA=nil end
        ApTh()
    end
    for k,r in pairs(CFG.Reg.t) do
        local v=(d.t and d.t[k]) or false
        pcall(function() r.s(v) r.cb(v) end)
    end
    for k,r in pairs(CFG.Reg.s) do
        local v=d.s and d.s[k]
        if v~=nil then pcall(function() r.s(v) r.cb(v) end) end
    end
end
local function CSave()
    local d=Cap()
    local ok,e=pcall(function() return Http:JSONEncode(d) end)
    if not ok then PNotif("Config","Error al guardar",C.Rd) return end
    local okF=false
    if CFG.HasIO then okF=pcall(function() writefile(CFG.File,e) end) end
    local sv=LP:FindFirstChild("TLG_Config")
    if not sv then sv=Instance.new("StringValue",LP) sv.Name="TLG_Config" end
    sv.Value=e
    if okF then PNotif("Config","Guardado en archivo",C.Grn)
    else PNotif("Config","Guardado temporal",C.Yel) end
end
local function CLoad()
    local e=nil
    if CFG.HasIO and isfile(CFG.File) then pcall(function() e=readfile(CFG.File) end) end
    if not e or e=="" then
        local sv=LP:FindFirstChild("TLG_Config")
        if sv then e=sv.Value end
    end
    if not e or e=="" then PNotif("Config","Sin config guardada",C.Rd) return end
    local ok,d=pcall(function() return Http:JSONDecode(e) end)
    if not ok or not d then PNotif("Config","Corrupta",C.Rd) return end
    CApply(d)
    PNotif("Config","Cargado",C.Grn)
end
local function CDel()
    if CFG.HasIO and isfile(CFG.File) then pcall(function() delfile(CFG.File) end) end
    local sv=LP:FindFirstChild("TLG_Config")
    if sv then sv:Destroy() end
    PNotif("Config","Eliminada",C.Rd)
end

