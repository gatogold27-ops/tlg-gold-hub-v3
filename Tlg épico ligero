-- AIMBOT
do
    Sec(PAb,"AIMBOT PRO")
    local AIM={On=false,C=nil,HSz=100000,Tr=1,R=999999,Neon=true,OS={}}
    local function ApA(p)
        if p==LP then return end
        local ch=p.Character if not ch then return end
        local h=ch:FindFirstChild("HumanoidRootPart")
        local hu=ch:FindFirstChildOfClass("Humanoid")
        if not h or not hu or hu.Health<=0 then return end
        if not AIM.OS[p] then
            AIM.OS[p]={S=h.Size,T=h.Transparency,C=h.CanCollide,M=h.Material,Co=h.Color}
        end
        pcall(function()
            h.Size=Vector3.new(AIM.HSz,AIM.HSz,AIM.HSz)
            h.Transparency=AIM.Tr
            h.CanCollide=false
            if AIM.Neon then h.Material=Enum.Material.Neon h.Color=A() end
            h.LocalTransparencyModifier=0
        end)
    end
    local function RsA(p)
        local d=AIM.OS[p] if not d then return end
        if p.Character then
            local h=p.Character:FindFirstChild("HumanoidRootPart")
            if h then
                pcall(function()
                    h.Size=d.S h.Transparency=d.T h.CanCollide=d.C
                    h.Material=d.M h.Color=d.Co
                end)
            end
        end
        AIM.OS[p]=nil
    end
    local function RsAll()
        for p,_ in pairs(AIM.OS) do RsA(p) end
        AIM.OS={}
    end
    local function InR(p)
        local mc=LP.Character if not mc then return false end
        local mr=mc:FindFirstChild("HumanoidRootPart")
        local tr=p.Character and p.Character:FindFirstChild("HumanoidRootPart")
        if not mr or not tr then return false end
        return (tr.Position-mr.Position).Magnitude<=AIM.R
    end
    local function Lp()
        if not AIM.On then return end
        for _,p in ipairs(P:GetPlayers()) do
            if p~=LP then
                if InR(p) then ApA(p)
                else if AIM.OS[p] then RsA(p) end end
            end
        end
    end
    local mb=Instance.new("TextButton",PAb)
    mb.Size=UDim2.new(1,0,0,46)
    mb.BackgroundColor3=C.BG2
    mb.BackgroundTransparency=0.1
    mb.Font=Enum.Font.GothamBold
    mb.Text="ACTIVAR AIMBOT"
    mb.TextColor3=A()
    mb.TextSize=13
    mb.BorderSizePixel=0
    mb.AutoButtonColor=false
    mb.ZIndex=5
    Instance.new("UICorner",mb).CornerRadius=UDim.new(0,10)
    local mbS=Instance.new("UIStroke",mb)
    mbS.Thickness=2
    RegS(mbS)
    Rip(mb)
    mb.MouseButton1Click:Connect(function()
        if AIM.On then
            AIM.On=false
            if AIM.C then pcall(function() AIM.C:Disconnect() end) AIM.C=nil end
            RsAll()
            mb.Text="ACTIVAR AIMBOT"
            TS:Create(mb,TweenInfo.new(0.3),{BackgroundColor3=C.BG2,TextColor3=A()}):Play()
            PNotif("Aimbot","Desactivado",C.Rd)
        else
            AIM.On=true
            for _,p in ipairs(P:GetPlayers()) do
                if p~=LP and InR(p) then ApA(p) end
            end
            AIM.C=RS.Heartbeat:Connect(Lp)
            mb.Text="DESACTIVAR AIMBOT"
            TS:Create(mb,TweenInfo.new(0.3),{BackgroundColor3=C.Rd,TextColor3=C.Wh}):Play()
            PNotif("Aimbot","Activado",C.Grn)
        end
    end)
    LP.CharacterAdded:Connect(function() if AIM.On then task.wait(1) RsAll() end end)
    Lbl(PAb,"Hitbox de 100,000 studs",C.Cyan)
    Lbl(PAb,"Pegas a cualquier distancia",C.Grn)
end

