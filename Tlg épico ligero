local TT={On=false,Active=false,Char=nil,CurTool=nil,Buf={},Held={},Burst={},LastTC=0,LastPU=0,Ping=50,Cnx={}}
local TTC={MinB=0.05,MaxB=0.12,MinAB=0.18,MaxAB=0.35,Grace=0.10,BC=3,BI=0.020}
local TTK={[Enum.KeyCode.Z]=true,[Enum.KeyCode.X]=true,[Enum.KeyCode.C]=true,[Enum.KeyCode.V]=true}
local TTAI=0.35
local TTLA=0
local function TTP()
    local s,r=pcall(function()
        local n=Stat:FindFirstChild("Network")
        if not n then return nil end
        local ss=n:FindFirstChild("ServerStatsItem")
        if ss then
            local dp=ss:FindFirstChild("Data Ping")
            if dp then return tonumber(string.match(dp:GetValueString(),"%d+")) end
        end
        return nil
    end)
    return (s and r and r>0) and r or TT.Ping
end
local function TTUT()
    TT.Ping=TTP()
    local ps=TT.Ping/1000
    TT.Buf=math.clamp(ps*0.8,TTC.MinB,TTC.MaxB)
end
local function TTUTo()
    if not TT.Char then TT.CurTool=nil return end
    local nt=TT.Char:FindFirstChildOfClass("Tool")
    if nt~=TT.CurTool then TT.CurTool=nt TT.LastTC=os.clock() end
end
local function TTAB(k)
    if not TT.Active or TT.Burst[k] then return end
    local t=TT.CurTool or (TT.Char and TT.Char:FindFirstChildOfClass("Tool"))
    if not t then return end
    TT.Burst[k]=true
    task.spawn(function()
        for i=1,TTC.BC do
            if not TT.Active or not t.Parent then break end
            if i>1 then task.wait(TTC.BI) end
            pcall(function() t:Activate() end)
        end
        TT.Burst[k]=nil
    end)
end
local function TTSC(c)
    TT.Active=false
    TT.Char=c
    local h=c:WaitForChild("Humanoid")
    TTUTo()
    TT.Active=true
end
local function TTS()
    if TT.On then return end
    TT.On=true
    table.insert(TT.Cnx,LP.CharacterAdded:Connect(function(c) task.wait(0.1) TTSC(c) end))
    if LP.Character then TTSC(LP.Character) end
    table.insert(TT.Cnx,RS.RenderStepped:Connect(function()
        if not TT.Active then return end
        local now=os.clock()
        if now-TT.LastPU>=1.0 then TTUT() TT.LastPU=now end
        TTUTo()
        for k,pt in pairs(TT.Buf) do
            if now-pt<=TTC.MaxAB then
                if not TT.Burst[k] and (TT.CurTool or (now-TT.LastTC<=TTC.Grace)) then
                    TT.Buf[k]=nil TTAB(k)
                end
            else TT.Buf[k]=nil end
        end
        if UI.TouchEnabled and TT.CurTool and now-TTLA>=TTAI then
            TTLA=now
            local t=TT.CurTool
            task.spawn(function()
                for i=1,TTC.BC do
                    if not TT.Active or not t.Parent then break end
                    if i>1 then task.wait(TTC.BI) end
                    pcall(function() t:Activate() end)
                end
            end)
        end
    end))
    if not UI.TouchEnabled then
        table.insert(TT.Cnx,UI.InputBegan:Connect(function(inp,gp)
            if gp or not TT.Active then return end
            if TTK[inp.KeyCode] and not TT.Held[inp.KeyCode] then
                TT.Held[inp.KeyCode]=true
                TT.Buf[inp.KeyCode]=os.clock()
            end
        end))
        table.insert(TT.Cnx,UI.InputEnded:Connect(function(inp)
            if TTK[inp.KeyCode] then TT.Held[inp.KeyCode]=nil end
        end))
    end
    PNotif("Timing Tools","Activado",C.Grn)
end
local function TTE()
    if not TT.On then return end
    TT.On=false TT.Active=false
    for _,c in ipairs(TT.Cnx) do pcall(function() c:Disconnect() end) end
    TT.Cnx={} TT.Buf={} TT.Held={} TT.Burst={}
    PNotif("Timing Tools","Desactivado",C.Rd)
end

