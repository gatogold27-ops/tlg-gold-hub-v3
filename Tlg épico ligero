local Ai={On=false,Sm=0.15,D=500,C=nil}
local function AiE()
    if Ai.C then pcall(function() Ai.C:Disconnect() end) Ai.C=nil end
    Ai.On=false
    pcall(function()
        if LP.Character then
            local hu=LP.Character:FindFirstChildOfClass("Humanoid")
            if hu and Cam then Cam.CameraSubject=hu end
        end
    end)
end
local function AiF()
    local b=nil local bd=Ai.D
    for _,p in ipairs(P:GetPlayers()) do
        if p~=LP then
            pcall(function()
                local ch=p.Character
                if ch then
                    local h=ch:FindFirstChild("Head")
                    if h and h:IsA("BasePart") then
                        local sp,on=Cam:WorldToViewportPoint(h.Position)
                        if on and sp.Z>0 then
                            local vp=Cam.ViewportSize
                            local ct=Vector2.new(vp.X/2,vp.Y/2)
                            local dp=(Vector2.new(sp.X,sp.Y)-ct).Magnitude
                            local d3=(Cam.CFrame.Position-h.Position).Magnitude
                            local mr=(Cam.FieldOfView/2)*(math.pi/180)
                            local rt=math.atan(dp/(vp.X/2))
                            if rt<=mr and d3<bd then bd=d3 b=h end
                        end
                    end
                end
            end)
        end
    end
    return b
end
local function AiS()
    if Ai.On then return end
    Ai.On=true
    Ai.C=RS.RenderStepped:Connect(function()
        if not Ai.On or not Cam then return end
        local o=AiF()
        if o then
            local cp=Cam.CFrame.Position
            local dr=(o.Position-cp).Unit
            Cam.CFrame=Cam.CFrame:Lerp(CFrame.new(cp,cp+dr),Ai.Sm)
        end
    end)
end

