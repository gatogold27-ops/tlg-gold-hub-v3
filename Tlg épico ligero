local AS={On=false,Conn=nil,Spam=nil}
local ASC={SpamRate=0.05,RestoreSpeed=true,RestoreJump=true,ForceTool=true,ForceStun=true}
local function ASS()
    if AS.On then return end
    AS.On=true
    AS.Conn=RS.Heartbeat:Connect(function()
        if not AS.On then return end
        pcall(function()
            local ch=LP.Character if not ch then return end
            local st=ch:FindFirstChild("Stun")
            if st and st:IsA("NumberValue") then st.Value=-1 end
            if ASC.ForceStun then
                for _,v in ipairs(ch:GetChildren()) do
                    if v:IsA("NumberValue") and v.Name:lower():find("stun") then v.Value=-1 end
                end
            end
            local hu=ch:FindFirstChildOfClass("Humanoid")
            if hu then
                if ASC.RestoreSpeed and hu.WalkSpeed<16 then hu.WalkSpeed=16 end
                if ASC.RestoreJump and hu.JumpPower<50 then hu.JumpPower=50 end
                if hu.PlatformStand then hu.PlatformStand=false end
            end
        end)
    end)
    AS.Spam=task.spawn(function()
        while AS.On do
            task.wait(ASC.SpamRate)
            pcall(function()
                if not ASC.ForceTool then return end
                local ch=LP.Character if not ch then return end
                local t=ch:FindFirstChildOfClass("Tool")
                if not t then return end
                local pr=UI:IsKeyDown(Enum.KeyCode.Z) or UI:IsKeyDown(Enum.KeyCode.X) or UI:IsKeyDown(Enum.KeyCode.C) or UI:IsKeyDown(Enum.KeyCode.V)
                if pr then pcall(function() t:Activate() end) end
            end)
        end
    end)
    PNotif("Anti-Stun PRO","Activado",C.Grn)
