local SAVE_FILE="TLG_Hub_Config.json"
local Config={}
local HAS_SAVE=(function()
local ok=pcall(function()
if isfile and writefile and readfile then return true end
end)
return ok and isfile and writefile and readfile
end)()

local function SaveConfig()
if not HAS_SAVE then return end
pcall(function()
writefile(SAVE_FILE,Http:JSONEncode(Config))
end)
end

local function LoadConfig()
if not HAS_SAVE then return end
pcall(function()
if isfile(SAVE_FILE) then
local data=readfile(SAVE_FILE)
local decoded=Http:JSONDecode(data)
for k,v in pairs(decoded) do
Config[k]=v
end
end
end)
end

local function GetCfg(key,default)
if Config[key]==nil then Config[key]=default end
return Config[key]
end

local function SetCfg(key,value)
Config[key]=value
task.spawn(SaveConfig)
end

LoadConfig()

local function ResetConfig()
