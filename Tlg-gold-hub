function IslandSystem.TeleportTo(nombreIsla,posicion)
local char=LP.Character
if not char then Notif("❌","Personaje no encontrado") return end
local hrp=char:FindFirstChild("HumanoidRootPart")
if not hrp then Notif("❌","HRP no encontrado") return end
local islandPart=nil
pcall(function()
for _,obj in ipairs(workspace:GetDescendants()) do
if obj:IsA("BasePart") or obj:IsA("Model") then
if string.find(string.lower(obj.Name),string.lower(nombreIsla),1,true) then
islandPart=obj
break
end
end
end
end)
if islandPart then
local part=islandPart
if part:IsA("Model") then
part=part.PrimaryPart or part:FindFirstChildWhichIsA("BasePart")
end
if part then
hrp.CFrame=CFrame.new(part.Position+Vector3.new(0,50,0))
Notif("🏝️ Teletransportado",nombreIsla)
return
end
end
if posicion then
hrp.CFrame=CFrame.new(posicion+Vector3.new(0,50,0))
Notif("🏝️ Teletransportado",nombreIsla.." (coords)")
else
Notif("❌","Isla no encontrada: "..nombreIsla)
end
end

function IslandSystem.DetectarIslas()
print("=== BUSCANDO ISLAS ===")
local encontradas={}
for _,obj in ipairs(workspace:GetDescendants()) do
if obj:IsA("Model") or obj:IsA("BasePart") then
local n=string.lower(obj.Name)
if string.find(n,"island") or string.find(n,"arena") or string.find(n,"floppa") or string.find(n,"snow") or string.find(n,"gorilla") or string.find(n,"sand") or string.find(n,"pumpkin") or string.find(n,"moai") or string.find(n,"sus") or string.find(n,"forgotten") or string.find(n,"mrbeast") then
local pos=nil
if obj:IsA("Model") then
local pp=obj.PrimaryPart or obj:FindFirstChildWhichIsA("BasePart")
if pp then pos=pp.Position end
else
pos=obj.Position
end
if pos then
encontradas[obj.Name]=pos
print("Encontrada:",obj:GetFullName(),"| Pos:",tostring(pos))
end
end
end
end
local count=0
for _ in pairs(encontradas) do count=count+1 end
Notif("Deteccion",count.." islas (ver consola)")
return encontradas
end

function IslandSystem.ActualizarCoordenadas()
local detectadas=IslandSystem.DetectarIslas()
local actualizadas=0
for nombre,pos in pairs(detectadas) do
for islaKey,_ in pairs(IslandSystem.Islas) do
local nl=string.lower(nombre)
local kl=string.lower(islaKey)
if string.find(nl,kl,1,true) or string.find(kl,nl,1,true) then
IslandSystem.Islas[islaKey]=pos
actualizadas=actualizadas+1
end
end
end
Notif("Coordenadas",actualizadas.." islas actualizadas")
return actualizadas
end

-- BUFF FRUTAS (Zero-Latency V9)
local BuffFrutas={
Activo=false,
AutoBurst=false,
AntiStunOn=false,
BurstCount=5,
BurstInterval=0.005,
Ping=50,
PingUpdate=1.0,
LastPingUpdate=0,
CurrentTool=nil,
BurstRunning=false,
Character=nil,
Humanoid=nil,
Stun=nil,
Connections={},
KeyConn=nil,
AutoConn=nil,
AttackAnimSpeed=2.50,
BaseAnimSpeed=1.30
}

local function BuffDisconnect()
for _,c in ipairs(BuffFrutas.Connections) do
if c and c.Disconnect then
pcall(function() c:Disconnect() end)
end
end
table.clear(BuffFrutas.Connections)
end

local function BuffGetPing()
local ok,res=pcall(function()
local network=Stats:FindFirstChild("Network")
if not network then return nil end
local ss=network:FindFirstChild("ServerStatsItem")
if ss then
local dp=ss:FindFirstChild("Data Ping")
if dp then
local num=tonumber(string.match(dp:GetValueString(),"%d+"))
if num then return num end
end
end
return nil
end)
return (ok and res and res>0) and res or BuffFrutas.Ping
end

local function BuffUpdateTool()
if not BuffFrutas.Character then
BuffFrutas.CurrentTool=nil
return
end
BuffFrutas.CurrentTool=BuffFrutas.Character:FindFirstChildOfClass("Tool")
end

local function BuffAnimSpeed(track)
if not track then return BuffFrutas.BaseAnimSpeed end
local text=""
pcall(function() text=text.." "..string.lower(track.Name) end)
pcall(function()
if track.Animation then
text=text.." "..string.lower(track.Animation.Name)
end
end)
if string.find(text,"attack") or string.find(text,"slash") or string.find(text,"skill") or string.find(text,"swing") then
return BuffFrutas.AttackAnimSpeed
end
return BuffFrutas.BaseAnimSpeed
end

local function BuffSetupAnimListener(hum)
if not hum then return end
local conn=hum.AnimationPlayed:Connect(function(track)
if not BuffFrutas.Activo or not track then return end
pcall(function() track:AdjustSpeed(BuffAnimSpeed(track)) end)
end)
table.insert(BuffFrutas.Connections,conn)
end

local function BuffBurst()
if not BuffFrutas.Activo then return end
local tool=BuffFrutas.CurrentTool or (BuffFrutas.Character and BuffFrutas.Character:FindFirstChildOfClass("Tool"))
if not tool or not tool.Parent then return end
if BuffFrutas.BurstRunning then return end
BuffFrutas.BurstRunning=true
task.spawn(function()
for i=1,BuffFrutas.BurstCount do
if not BuffFrutas.Activo or not tool.Parent then break end
pcall(function() tool:Activate() end)
if i<BuffFrutas.BurstCount then
task.wait(BuffFrutas.BurstInterval)
end
end
BuffFrutas.BurstRunning=false
end)
end

local function BuffSetupCharacter(char)
BuffDisconnect()
BuffFrutas.Activo=false
BuffFrutas.Character=char
BuffFrutas.Humanoid=char:WaitForChild("Humanoid")
BuffFrutas.Stun=char:WaitForChild("Stun",5)
BuffUpdateTool()
BuffSetupAnimListener(BuffFrutas.Humanoid)
table.insert(BuffFrutas.Connections,char.ChildAdded:Connect(function(ins)
if ins:IsA("Tool") then BuffUpdateTool() end
end))
table.insert(BuffFrutas.Connections,char.ChildRemoved:Connect(function(ins)
if ins:IsA("Tool") then BuffUpdateTool() end
end))
table.insert(BuffFrutas.Connections,BuffFrutas.Humanoid.Died:Connect(function()
BuffFrutas.Activo=false
end))
BuffFrutas.Activo=true
end

if LP.Character then pcall(BuffSetupCharacter,LP.Character) end
LP.CharacterAdded:Connect(function(c) pcall(BuffSetupCharacter,c) end)

local function BuffStartKeys()
if BuffFrutas.KeyConn then return end
BuffFrutas.KeyConn=UI.InputBegan:Connect(function(input,gp)
if gp then return end
if not BuffFrutas.AutoBurst then return end
local k=input.KeyCode
if k==Enum.KeyCode.Z or k==Enum.KeyCode.X or k==Enum.KeyCode.C or k==Enum.KeyCode.V then
BuffBurst()
end
end)
end

local function BuffStopKeys()
if BuffFrutas.KeyConn then
pcall(function() BuffFrutas.KeyConn:Disconnect() end)
BuffFrutas.KeyConn=nil
end
end

local function BuffStartAuto()
if BuffFrutas.AutoConn then return end
BuffFrutas.AutoConn=task.spawn(function()
while BuffFrutas.AutoBurst do
task.wait(0.35)
if BuffFrutas.AutoBurst and BuffFrutas.Activo and BuffFrutas.CurrentTool then
BuffBurst()
end
end
BuffFrutas.AutoConn=nil
end)
end

local function BuffStopAuto()
BuffFrutas.AutoBurst=false
end

task.spawn(function()
while true do
RS.RenderStepped:Wait()
if BuffFrutas.AntiStunOn and BuffFrutas.Stun and BuffFrutas.Stun.Parent then
pcall(function() BuffFrutas.Stun.Value=-1 end)
end
local now=os.clock()
if now-BuffFrutas.LastPingUpdate>=BuffFrutas.PingUpdate then
BuffFrutas.Ping=BuffGetPing()
BuffFrutas.LastPingUpdate=now
end
if BuffFrutas.Activo then pcall(BuffUpdateTool) end
end
end)

