-- Gradiente animado (barre de color que se mueve)
local function AnimatedGradient(parent, col1, col2, speed)
    local g=Instance.new("UIGradient",parent)
    g.Color=ColorSequence.new(col1,col2)
    g.Rotation=0
    speed=speed or 0.02
    task.spawn(function()
        local offset=0
        while g and g.Parent do
            offset=offset+0.01
            if offset>2 then offset=0 end
            g.Offset=Vector2.new(offset-1,0)
            task.wait(speed)
        end
    end)
    table.insert(ThemedGradients,{grad=g})
    return g
end

-- Glow pulsante (borde que respira)
local function PulsingGlow(stroke, minT, maxT, dur)
    minT=minT or 0.2 maxT=maxT or 0.8 dur=dur or 1.5
    task.spawn(function()
        while stroke and stroke.Parent do
            local t1=TS:Create(stroke,TweenInfo.new(dur,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Transparency=maxT})
            t1:Play() t1.Completed:Wait()
            if not stroke.Parent then break end
            local t2=TS:Create(stroke,TweenInfo.new(dur,Enum.EasingStyle.Sine,Enum.EasingDirection.InOut),{Transparency=minT})
            t2:Play() t2.Completed:Wait()
        end
    end)
end

-- Hover lift para botones/frames
local function HoverLift(obj, hoverColor, baseColor, offset)
    offset=offset or 2
    local basePos=obj.Position
    obj.MouseEnter:Connect(function()
        TS:Create(obj,TweenInfo.new(0.15,Enum.EasingStyle.Quad),{
            BackgroundColor3=hoverColor,
            Position=basePos-UDim2.new(0,0,0,offset),
        }):Play()
    end)
    obj.MouseLeave:Connect(function()
        TS:Create(obj,TweenInfo.new(0.15,Enum.EasingStyle.Quad),{
            BackgroundColor3=baseColor,
            Position=basePos,
        }):Play()
    end)
end

