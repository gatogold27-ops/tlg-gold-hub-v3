local Orb={On=false,Spd=3000,D=1000,A=100,C=nil,Ang=0}
local function OrbStart()
    if Orb.C then return end
    Orb.On=true Orb.Ang=0
    task.spawn(function()
        local ch=LP.Character or LP.CharacterAdded:Wait()
        local h=ch:WaitForChild("HumanoidRootPart",5)
        local hu=ch:FindFirstChildOfClass("Humanoid")
        if not h or not hu then Orb.On=false return end
        hu.PlatformStand=true
        Orb.C=RS.Heartbeat:Connect(function(dt)
            if not Orb.On or not h.Parent then
                if Orb.C then Orb.C:Disconnect()Orb.C=nil end
                pcall(function()hu.PlatformStand=false end)return
            end
            if not hu.PlatformStand then hu.PlatformStand=true end
            local av=math.min(Orb.Spd/math.max(Orb.D,1),20)
            Orb.Ang=Orb.Ang+av*dt
            if Orb.Ang>math.pi*2 then Orb.Ang=Orb.Ang-math.pi*2 end
