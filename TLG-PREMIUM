local function AiFind()
    local best=nil local bd=Ai.D
    for _,plr in ipairs(P:GetPlayers())do
        if plr~=LP then
            pcall(function()
                local ch=plr.Character
                if ch then
                    local p
                    if Ai.Pt=="Head"then p=ch:FindFirstChild("Head")
                    elseif Ai.Pt=="Torso"then p=ch:FindFirstChild("UpperTorso")or ch:FindFirstChild("Torso")
                    else p=ch:FindFirstChild("HumanoidRootPart")end
                    if p and p:IsA("BasePart")then
                        local sp,on=Cam:WorldToViewportPoint(p.Position)
                        if on and sp.Z>0 then
                            local vp=Cam.ViewportSize
                            local ct=Vector2.new(vp.X/2,vp.Y/2)
                            local dp=(Vector2.new(sp.X,sp.Y)-ct).Magnitude
                            local d3=(Cam.CFrame.Position-p.Position).Magnitude
                            local mr=(Cam.FieldOfView/2)*(math.pi/180)
                            local rt=math.atan(dp/(vp.X/2))
                            if rt<=mr and d3<bd then bd=d3 best=p end
                        end
                    end
                end
            end)
        end
    end
    return best
end
local function AiStart()
    if Ai.On then return end
    Ai.On=true
    Ai.C=RS.RenderStepped:Connect(function()
        if not Ai.On or not Cam then return end
        local o=AiFind()
        if o then
            local cp=Cam.CFrame.Position
            local dir=(o.Position-cp).Unit
            Cam.CFrame=Cam.CFrame:Lerp(CFrame.new(cp,cp+dir),Ai.Sm)
        end
    end)
end

