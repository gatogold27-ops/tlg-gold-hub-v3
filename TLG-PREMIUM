-- [7] MAGNET
local MGT={On=false,Active=false,HB={},BV={}}
local MGT_CFG={Size=3500,PullRate=0.02,BoostSpd=900,Range=9000}
local function MGT_Apply(plr)
    if plr==LP then return end
    local ch=plr.Character if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart") if not hrp then return end
    local d=MGT.HB[plr]
    if not d or d.hrp~=hrp then
        MGT.HB[plr]={hrp=hrp,sz=hrp.Size,tr=hrp.Transparency,mt=hrp.Material,cl=hrp.Color}
    end
    local s=MGT_CFG.Size
    hrp.Size=Vector3.new(s,s,s) hrp.Transparency=1 hrp.LocalTransparencyModifier=0
    hrp.Material=Enum.Material.Neon hrp.Color=Color3.fromRGB(255,50,100) hrp.CanCollide=false
end
local function MGT_Restore(plr)
    local d=MGT.HB[plr]
    if d and d.hrp and d.hrp.Parent then pcall(function()
        d.hrp.Size=d.sz d.hrp.Transparency=d.tr d.hrp.Material=d.mt d.hrp.Color=d.cl
    end) end
    MGT.HB[plr]=nil
    local bv=MGT.BV[plr]
    if bv then pcall(function()bv:Destroy()end)MGT.BV[plr]=nil end
end
local function MGT_Clean()
    for plr,_ in pairs(MGT.HB)do MGT_Restore(plr)end
    MGT.HB={}MGT.BV={}
end
local function MGT_Boost(plr)
    if plr==LP then return end
    local ch=plr.Character if not ch then return end
    local hrp=ch:FindFirstChild("HumanoidRootPart")
    local my=LP.Character and LP.Character:FindFirstChild("HumanoidRootPart")
    if not hrp or not my then return end
    local dist=(hrp.Position-my.Position).Magnitude
    if dist>MGT_CFG.Range then return end
    local bv=MGT.BV[plr]
    if not bv or not bv.Parent then
        bv=Instance.new("BodyVelocity") bv.Name="_TLG_MGT"
        bv.MaxForce=Vector3.new(1e7,1e7,1e7) bv.Parent=hrp MGT.BV[plr]=bv
    end
    local dir=(my.Position-hrp.Position).Unit
    bv.Velocity=dir*(MGT_CFG.BoostSpd*(1+math.min(dist/400,4)))
end
local mHB,mBoost,mPull=0,0,0
RS.Heartbeat:Connect(function(dt)
    if not MGT.On then return end
    mHB=mHB+dt mBoost=mBoost+dt mPull=mPull+dt
    if mHB>=0.2 then mHB=0
        for _,plr in ipairs(P:GetPlayers())do if plr~=LP then pcall(MGT_Apply,plr)end end
    end
    if MGT.Active then
        if mBoost>=0.05 then mBoost=0
            for _,plr in ipairs(P:GetPlayers())do if plr~=LP and plr.Character then pcall(MGT_Boost,plr)end end
        end
        if mPull>=MGT_CFG.PullRate then mPull=0
            local ch=LP.Character
            if ch then
                local tool=ch:FindFirstChildOfClass("Tool")
                if tool then pcall(function()tool:Activate()end)end
            end
        end
    else
        if next(MGT.BV) then
            for plr,bv in pairs(MGT.BV)do
                if bv then pcall(function()bv:Destroy()end)MGT.BV[plr]=nil end
            end
        end
    end
end)

