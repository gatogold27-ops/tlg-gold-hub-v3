local function CreateFAB(icon,label,key,cb)
    local btn=Instance.new("TextButton",FAB_Holder)
    btn.Size=UDim2.new(0,60,0,52)
    btn.BackgroundColor3=C.BG2
    btn.Text=""
    btn.BorderSizePixel=0
    btn.AutoButtonColor=false
    btn.ZIndex=12
    btn.ClipsDescendants=true
    Instance.new("UICorner",btn).CornerRadius=UDim.new(0,8)
    local bS=Instance.new("UIStroke",btn)
    bS.Thickness=2
    bS.Color=A()
    bS.Transparency=0.4
    local iL=Instance.new("TextLabel",btn)
    iL.Size=UDim2.new(1,0,0,24)
    iL.Position=UDim2.new(0,0,0,4)
    iL.BackgroundTransparency=1
    iL.Text=icon
    iL.TextSize=20
    iL.TextColor3=C.Wh
    iL.Font=Enum.Font.GothamBold
    iL.ZIndex=13
    local nL=Instance.new("TextLabel",btn)
    nL.Size=UDim2.new(1,0,0,12)
    nL.Position=UDim2.new(0,0,1,-16)
    nL.BackgroundTransparency=1
    nL.Text=label
    nL.TextColor3=C.Wh
    nL.TextSize=8
    nL.Font=Enum.Font.GothamBold
    nL.ZIndex=13
    local kL=Instance.new("TextLabel",btn)
    kL.Size=UDim2.new(1,0,0,10)
    kL.Position=UDim2.new(0,0,1,-26)
    kL.BackgroundTransparency=1
    kL.Text=key
    kL.TextColor3=C.Gr
    kL.TextSize=8
    kL.Font=Enum.Font.GothamBold
    kL.ZIndex=13
    local function SetActive(state)
        if state then
            btn.BackgroundColor3=A()
            iL.TextColor3=C.BG
            nL.TextColor3=C.BG
            kL.TextColor3=C.BG
            bS.Color=C.Wh
            bS.Transparency=0
        else
            btn.BackgroundColor3=C.BG2
            iL.TextColor3=C.Wh
            nL.TextColor3=C.Wh
            kL.TextColor3=C.Gr
            bS.Color=A()
            bS.Transparency=0.4
        end
    end
    btn.MouseButton1Click:Connect(function()
        local newState=cb()
        if newState~=nil then SetActive(newState)end
    end)
    SetActive(false)
    return btn
end
