local function GetStats(plr)
    local s={Level=0,Health=0,MaxHealth=0,Melee=0,Weapon=0,Power=0,Kills=0,Deaths=0}
    pcall(function()
        local ch=plr.Character
        if ch then
            local hu=ch:FindFirstChildOfClass("Humanoid")
            if hu then s.Health=math.floor(hu.Health)s.MaxHealth=math.floor(hu.MaxHealth)end
        end
    end)
    pcall(function()
        local ls=plr:FindFirstChild("leaderstats")
        if ls then
            for _,v in ipairs(ls:GetChildren())do
                if v:IsA("IntValue")or v:IsA("NumberValue")or v:IsA("StringValue")then
                    local n=v.Name:lower()
                    local val=tonumber(v.Value)or 0
                    if n=="level"or n=="nivel"or n=="lvl"then s.Level=val
                    elseif n=="kills"or n=="kill"or n=="ko"then s.Kills=val
                    elseif n=="deaths"or n=="death"or n=="wins"then s.Deaths=val
                    elseif n=="melee"then s.Melee=val
                    elseif n=="sword"or n=="weapon"then s.Weapon=val
                    elseif n=="power"or n=="poder"then s.Power=val
                    end
                end
            end
        end
    end)
    pcall(function()
        local pd=plr:FindFirstChild("PlayerData")
        if pd then
            local function g(n)local v=pd:FindFirstChild(n)if v and(v:IsA("IntValue")or v:IsA("NumberValue"))then return v.Value end return nil end
            local lv=g("Level")or g("Lvl")if lv then s.Level=tonumber(lv)or s.Level end
            local ml=g("MeleeLevel")if ml then s.Melee=tonumber(ml)or 0 end
            local sl=g("SwordLevel")if sl then s.Weapon=tonumber(sl)or 0 end
            local pw=g("MemePowerLevel")if pw then s.Power=tonumber(pw)or 0 end
        end
    end)
    return s
end
